<Project Sdk="WixToolset.Sdk/5.0.2"><PropertyGroup><EnableDefaultCompileItems>false</EnableDefaultCompileItems><OutputName>GnxNode</OutputName><HostAgentExe Condition="'$(HostAgentExe)' == ''">$(MSBuildProjectDirectory)\..\gnx-node\target\release\gnx-host-agent.exe</HostAgentExe><SetupExe Condition="'$(SetupExe)' == ''">$(MSBuildProjectDirectory)\..\gnx-node\target\release\gnx-setup.exe</SetupExe><SetupUi Condition="'$(SetupUi)' == ''">$(MSBuildProjectDirectory)\..\gnx-node\apps\setup\ui\index.html</SetupUi><HostPayload Condition="'$(HostPayload)' == ''">$(MSBuildProjectDirectory)\..\gnx-node\payload\host</HostPayload><DefineConstants>HostAgentExe=$(HostAgentExe);SetupExe=$(SetupExe);SetupUi=$(SetupUi);HostPayload=$(HostPayload)</DefineConstants></PropertyGroup><ItemGroup><Compile Include="Product.wxs" /></ItemGroup></Project>
